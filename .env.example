# ==============================================================================
# JobFit Resume — Environment Configuration Template
# ==============================================================================

# Spring Environment Profile: 'dev' (uses zero-config embedded H2 in PostgreSQL mode)
# or 'prod' (connects to PostgreSQL via DATABASE_URL)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Application Base URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration (Required for 'prod' profile or Docker Compose)
# Example PostgreSQL URL: jdbc:postgresql://localhost:5432/jobfit_db
DATABASE_URL=jdbc:postgresql://localhost:5432/jobfit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security & JWT Token Configuration
# Generate a strong 256-bit secret for production: openssl rand -base64 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Cookie Security (set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Optional SMTP Email Configuration (for password reset notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@jobfitresume.com
MAIL_PASSWORD=secret_mail_password
MAIL_FROM=JobFit Resume <noreply@jobfitresume.com>

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
